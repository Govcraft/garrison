# Hidden files and directories (except .gitignore)
.*
!.gitignore
!.cargo/
!.cargo/**
!.github/
!.github/**
!extensions/vscode/.vscode/
!extensions/vscode/.vscode/launch.json

# Text and markdown files (except README.md)
*.txt
*.md
!README.md
!CLA.md
!CONTRIBUTING.md
!LICENSING.md
!TRADEMARKS.md
keys/
.env
*.pcap
target/
build/
node_modules/
dist/
*.vsix
!README.md
!docs/**/*.md
!CHANGELOG.md

# Regenerated into the project root by hooks-service/build.rs on every build,
# so the plane can reference a stable path without picking up a stale copy.
hooks-service/hooks_descriptor.bin
