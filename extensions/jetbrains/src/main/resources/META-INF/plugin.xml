<idea-plugin>
    <id>com.govcraft.garrison</id>
    <name>Garrison</name>
    <vendor url="https://github.com/Govcraft/garrison">Govcraft</vendor>
    <description><![CDATA[
        Governed agentic coding inside your JetBrains IDE. Connects to the
        Garrison agent over ACP for streamed chat, tool activity, approvals,
        cancellation, and governance status.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Garrison"
                    anchor="right"
                    icon="/icons/garrison.svg"
                    factoryClass="com.govcraft.garrison.GarrisonToolWindowFactory"/>
        <applicationService serviceImplementation="com.govcraft.garrison.GarrisonSettings"/>
        <applicationConfigurable id="com.govcraft.garrison.settings"
                                 displayName="Garrison"
                                 instance="com.govcraft.garrison.GarrisonConfigurable"/>
        <inline.completion.provider
                implementation="com.govcraft.garrison.GarrisonInlineCompletionProvider"/>
    </extensions>

    <actions>
        <action id="Garrison.Send" class="com.govcraft.garrison.GarrisonActions$Send"
                text="Garrison: Send Prompt" description="Send the current Garrison prompt"/>
        <action id="Garrison.Cancel" class="com.govcraft.garrison.GarrisonActions$Cancel"
                text="Garrison: Cancel Turn" description="Cancel the active Garrison turn"/>
        <action id="Garrison.NewSession" class="com.govcraft.garrison.GarrisonActions$NewSession"
                text="Garrison: New Session" description="Clear the transcript and start a new Garrison session"/>
        <action id="Garrison.ShowStatus" class="com.govcraft.garrison.GarrisonActions$ShowStatus"
                text="Garrison: Show Governance Status" description="Show the current Garrison governance status"/>
    </actions>
</idea-plugin>
