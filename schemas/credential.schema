// Garrison control plane — how a daemon proves it is itself.
//
// An Operator is a human with an Entra token. A garrison-agent daemon
// heartbeats at 03:00 with nobody logged in, so it cannot borrow that token
// and must carry an identity of its own. These two schemas are that identity,
// split along the only line that matters: what is secret and what is not.
//
//   EnrollmentToken  — a one-time secret, hashed, short-lived, human-issued.
//                      The bootstrap, and the only secret this plane stores.
//   InstallCredential — public verification material. Nothing secret at rest.
//
// The daemon generates its own keypair at enrollment and never transmits the
// private half; the plane records the public half and verifies signatures
// against it. A shared bearer secret would have been simpler and is
// deliberately absent: it would put a replayable credential in the database,
// on the wire at every heartbeat, and in a file on every workstation, which
// is three copies of a thing that only needs to exist in one place. The one
// unavoidable secret is the enrollment token, and it is spent once.
//
// Both schemas keep their secret-bearing and identity-bearing fields out of
// the generic CRUD surface. `secret_hash` is @hidden, which means it is
// stripped from every response *and rejected in any request body* — so an
// enrollment token cannot be minted through the REST API at all, by anyone,
// including org_admin. Minting is a server-side route that writes through the
// storage layer. That is a constraint, not an oversight: a provisioning
// credential you can POST into existence is a provisioning credential an
// over-broad token can POST into existence.
//
// Neither is deletable; see policies/custom/credential-lifecycle.cedar. A
// revoked credential is the evidence that it was revoked.

// A one-time provisioning secret. Issued by a human, shown once, redeemed by
// a daemon that has never spoken to the plane before.
//
// Scope bounds the blast radius: an operator-scoped token provisions one
// person's machine, an organization-scoped token can provision anything that
// holds it, which is why `max_uses` and `expires_at` are not optional in
// practice even though only the count is enforceable here.
@version(1)
@tenant(parent: "Organization")
@display("token_id")
@access(
    read:   ["auditor", "security_officer", "org_admin"],
    write:  ["security_officer", "org_admin"],
    delete: ["org_admin"]
)
schema EnrollmentToken {
    // The public half of the token: safe to log, safe to show in a list, and
    // what the daemon sends alongside the secret so the plane knows which row
    // to hash against.
    token_id:          text(max: 64) required unique indexed @list(primary)

    // Argon2id over the one-time secret. The plaintext is displayed to the
    // issuing human exactly once and never stored.
    secret_hash:       text(max: 512) required @hidden

    organization:      -> Organization required

    scope:             enum("organization", "team", "operator")
                       required
                       @enum_colors(organization: "violet", team: "blue", operator: "teal")
                       @list(column)
    team:              -> Team
    operator:          -> Operator

    max_uses:          integer(min: 1) default(1) @default("1")
    uses:              integer(min: 0)
                       default(0)
                       @default("0")
                       @require(
                           "uses <= max_uses",
                           "an enrollment token cannot be redeemed more times than it allows"
                       )

    status:            enum("issued", "redeemed", "expired", "revoked")
                       default("issued")
                       @default("'issued'")
                       @enum_colors(issued: "blue", redeemed: "green", expired: "gray", revoked: "red")
                       @list(column)

    issued_at:         datetime @default("now")
    issued_by:         text(max: 320) required
    expires_at:        datetime required @format("relative")
    first_redeemed_at: datetime
    last_redeemed_at:  datetime
    revoked_at:        datetime

    revocation_reason: text(max: 512)
                       @default("''")
                       @require(
                           "status != 'revoked' || size(revocation_reason) > 0",
                           "revoking an enrollment token requires a recorded reason"
                       )

    installs:          -> AgentInstall[]
}

// The daemon's standing identity. One install may hold more than one row:
// during rotation the outgoing credential stays 'rotating' until the new one
// has been used, so a key roll does not require a maintenance window.
//
// Operators are absent from the read list on purpose. A daemon holds its own
// private key and needs nothing from this table; being able to enumerate the
// fleet's credentials is a capability it has no use for.
@version(1)
@tenant(parent: "Organization")
@display("credential_id")
@access(
    read:   ["team_lead", "auditor", "security_officer", "org_admin"],
    write:  ["security_officer", "org_admin"],
    delete: ["org_admin"]
)
schema InstallCredential {
    // The key id the daemon presents. Public by construction.
    credential_id:     text(max: 64) required unique indexed @list(primary)

    install:           -> AgentInstall required
    organization:      -> Organization required

    kind:              enum("ed25519", "x509_mtls")
                       required
                       @enum_colors(ed25519: "teal", x509_mtls: "blue")
                       @list(column)

    // Base64 SPKI. For an mTLS credential this is the subject public key
    // carried by the certificate, so signature verification looks the same
    // either way and only the trust path differs.
    public_key:        text(max: 1024) required

    // SHA-256 of the DER certificate, which is what acton-service's client
    // certificate verification pins against. Meaningless for a bare keypair.
    cert_fingerprint:  text(max: 128)
                       indexed
                       @default("''")
                       @require(
                           "kind != 'x509_mtls' || size(cert_fingerprint) == 64",
                           "an mTLS credential must record its certificate fingerprint"
                       )
    cert_serial:       text(max: 128)
    issuing_ca:        text(max: 255)

    status:            enum("pending", "active", "rotating", "revoked", "expired")
                       default("pending")
                       @default("'pending'")
                       @enum_colors(
                           pending: "gray",
                           active: "green",
                           rotating: "amber",
                           revoked: "red",
                           expired: "neutral"
                       )
                       @list(column)
                       // A retired install has no business holding a live key.
                       // Single-hop related read, evaluated against the
                       // committed install row.
                       @require(
                           "status != 'active' || related.install.status != 'retired'",
                           "a retired install cannot hold an active credential"
                       )

    // The credential this one supersedes. Self-referencing so a rotation
    // chain is walkable: every key back to enrollment, in order.
    supersedes:        -> InstallCredential

    issued_at:         datetime @default("now")
    expires_at:        datetime @format("relative")
    activated_at:      datetime
    last_used_at:      datetime @format("relative")
    // IPv6 textual maximum, so the column never silently truncates an address.
    last_used_from:    text(max: 45)
    use_count:         integer(min: 0) default(0)

    revoked_at:        datetime
    revoked_by:        text(max: 320)
    revocation_reason: text(max: 512)
                       @default("''")
                       @require(
                           "status != 'revoked' || size(revocation_reason) > 0",
                           "revoking an install credential requires a recorded reason"
                       )
}
