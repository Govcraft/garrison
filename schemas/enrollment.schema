// Garrison control plane — redemption.
//
// A daemon that has never spoken to the plane presents its enrollment
// artifact and asks to be admitted. This is that request, modeled as an
// entity rather than as a bespoke route, because SchemaForge already
// generates the endpoint, the authorization, and the audit for one.
//
// The daemon authenticates with the artifact itself. It is a PASETO minted
// under the console issuer carrying the single role `enrollee`, which is
// granted write on this schema and nothing else anywhere in the bundle — an
// allowlist of exactly one action rather than a credential that is merely
// refused everywhere else. Verified: a token bearing a role no policy grants
// is a 403 on every route, so the failure mode of getting this wrong is a
// daemon that cannot enroll, not one that can do more than enroll.
//
// Binding the request to the artifact is not a Cedar policy, and that is a
// limitation worth stating rather than discovering. On a create there is no
// entity yet, so the engine authorizes against a placeholder resource whose
// attributes are type defaults (schema-forge-acton, authz/adapters.rs).
// `resource.token_id` is therefore "" no matter what the daemon sent, and no
// Cedar rule can compare it against anything.
//
// So everything the plane must not take on faith is left for the hook, which
// runs before persistence-side validation and can therefore fill fields the
// daemon never sends. Cedar decides who may redeem; the hook decides which
// grant they are redeeming and on whose behalf.
//
// Both `token_id` and `organization` are filled that way. A v4.local artifact
// is encrypted with the plane's own key, so a daemon cannot read its own
// claims and has nothing truthful to assert about either. The hook takes the
// first from the authenticated principal's subject and the second from the
// EnrollmentToken row. A field the client cannot know is a field the client
// cannot lie about, and a field the client cannot send is one it cannot
// misuse.

@version(1)
@tenant(parent: "Organization")
@display("hostname")
@access(
    read:   ["auditor", "security_officer", "org_admin"],
    write:  ["enrollee"],
    delete: ["org_admin"]
)
@hook(before_validate) """Resolve the enrollment token, admit or refuse the install, and provision its credential"""
schema Redemption {
    // The artifact's `sub`, resolved by the hook from the authenticated
    // principal and never sent by the daemon.
    //
    // This is the whole anti-replay story, and it is stronger than the
    // `@require` it replaces. A rule comparing a submitted `token_id` against
    // `principal.sub` can only refuse a mismatch; a client that cannot express
    // the field at all cannot attempt one. It is the same shape as
    // `organization` below and `AuditEvent.operator`: a field the client
    // cannot know is a field the client cannot lie about.
    //
    // Not `required`, and that is not a softening. Required-field validation
    // runs against the raw request body before `before_validate` is dialed, so
    // a field the client is meant not to send cannot also be one the client
    // must send. What holds it closed is the binding's `required = true` in
    // config.toml: an unreachable hook fails the request rather than
    // persisting an unfilled row.
    token_id:          text(max: 64) indexed

    // Resolved by the hook, never sent by the daemon.
    organization:      -> Organization
    enrollment_token:  -> EnrollmentToken

    // What the daemon reports about itself. Claims, not facts, until the
    // hook writes them onto the AgentInstall it creates.
    install_id:        text(max: 64) required indexed
    hostname:          text(max: 255) required @list(primary)

    // Who this machine is for. An AgentInstall must name an Operator, and an
    // organization-scoped token names none, so the daemon reports the UPN and
    // the hook resolves it. For an operator-scoped token the hook ignores this
    // and uses the token's own binding — a claim is only trusted where the
    // grant did not already answer the question.
    operator_upn:      text(max: 320)
    platform:          enum("linux", "macos", "windows") required
    agent_version:     text(max: 32) required @list(column)
    acton_ai_version:  text(max: 32)
    sandbox_hardening: enum("enforce", "best_effort", "unavailable")
                       required
                       @enum_colors(enforce: "green", best_effort: "amber", unavailable: "red")
    isolation_active:  boolean default(false)

    // The credential it wants registered. Public material only, matching
    // InstallCredential — the daemon keeps its private key.
    credential_kind:   enum("ed25519", "x509_mtls") required
    public_key:        text(max: 1024) required
    cert_fingerprint:  text(max: 128)
                       @default("''")
                       @require(
                           "credential_kind != 'x509_mtls' || size(cert_fingerprint) == 64",
                           "an mTLS enrollment must present its certificate fingerprint"
                       )

    // The verdict. The hook writes these onto the entity, and because the
    // create response is the persisted entity, they are how the daemon
    // learns its own identity — the one thing a generic CRUD create can
    // hand back that was not in the request.
    outcome:           enum("pending", "accepted", "refused")
                       default("pending")
                       @default("'pending'")
                       @enum_colors(pending: "gray", accepted: "green", refused: "red")
                       @list(column)
    refusal_reason:    text(max: 512) @default("''")
    install:           -> AgentInstall
    credential:        -> InstallCredential

    requested_at:      datetime @default("now") @format("relative")
    decided_at:        datetime
    source_ip:         text(max: 45)
}
