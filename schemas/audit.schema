// Garrison control plane — audit aggregation.
//
// The agent keeps a BLAKE3 hash-chained JSONL trail locally; acton-ai seals
// every entry with its sequence, the previous hash, and the trail id it belongs
// to. Three schemas describe that trail from three vantage points:
//
//   AuditTrail:  what the daemon says about its own trail: where the local
//                 head is and how far it has shipped. Written by the operator
//                 token, so it is a claim.
//   AuditEvent:  one shipped entry, the sealed line verbatim in `entry` with
//                 the chain fields lifted out for indexing. Written by the
//                 operator token, verified by the hook before it lands.
//   AuditChain:  what the plane has verified: the head it re-derived and
//                 whether the walk found the chain intact. Written only by the
//                 audit service, never by an install.
//
// Silence is the difference between the first and the third over time: a trail
// whose local head keeps moving while its chain does not is an install that
// stopped shipping, and a trail that stops reporting at all is an install that
// went dark.
//
// Access is deliberately lopsided. Operators (the agents) may append and may
// not read; auditors may read and may not append.
//
// Deletion is forbidden outright, but not by writing `delete: []` here — an
// empty list reads as "unconstrained" and generates a permit for *any*
// authenticated principal, which is the opposite of the intent. The generated
// permit is narrowed to org_admin so a lost policy file degrades to the highest
// role rather than to everyone, and policies/custom/audit-append-only.cedar
// carries the real rule as a Cedar `forbid`, which beats every permit including
// platform_admin's. An append-only trail with a delete verb is a trail with an
// eraser in the drawer.
//
// AuditEvent and AuditChain carry `@export` for SIEM handoff. Export is
// fail-closed twice over: a schema without `@export` cannot be exported at all,
// a field without `@exportable` never reaches a file, and the exported set is
// intersected with what the caller may already read. It is also a distinct
// Cedar action (`ExportAuditEvent`, not `Read`), so granting the trail to a
// reader does not grant them a bulk copy of it.

// The daemon's own account of one trail. One row per trail id, created by the
// install when the trail opens and patched as it ships. Nothing here is
// verified; it is the install's claim, and AuditChain is the plane's answer.
@version(1)
@tenant(parent: "Organization")
@display("trail_id")
@access(
    read:   ["operator", "team_lead", "auditor", "security_officer", "org_admin", "audit_service"],
    write:  ["operator"],
    delete: ["org_admin"]
)
schema AuditTrail {
    // acton-ai's trail id, minted when the trail file is opened. Unique per
    // tenant so two installs cannot claim the same trail.
    trail_id:         text(max: 64) required unique indexed @list(primary)

    install:          -> AgentInstall required
    organization:     -> Organization required

    agent_version:    text(max: 32)
    acton_ai_version: text(max: 32)
    started_at:       datetime

    // The local head as the daemon last reported it.
    local_head_seq:   integer(min: 0) default(0) @list(column)
    local_head_hash:  text(max: 128)
    // The highest sequence the daemon believes the plane has acknowledged.
    shipped_through:  integer(min: 0) default(0) @list(column)

    reported_at:      datetime @default("now") @format("relative")

    // Set when the daemon halts shipping on its own account: a broken local
    // chain, a refused entry, a full backlog. Empty while healthy.
    halted_reason:    text(max: 1024) @default("''")
}

@version(1)
@tenant(parent: "Organization")
@display("tool_name")
@access(
    read:   ["team_lead", "auditor", "security_officer", "org_admin", "audit_service"],
    write:  ["operator"],
    delete: ["org_admin"]
)
@export(formats: [csv, ndjson], bundle_files: false, max_rows: 250000)
@hook(before_validate) """Verify the shipped entry against the trail's chain state; refuse forks and edits, record gaps"""
schema AuditEvent {
    organization:  -> Organization required
    trail:         -> AuditTrail required indexed
    // Attribution by session is optional: a trail belongs to an install, and
    // an entry may be sealed before any session is known to the plane.
    session:       -> AgentSession

    // Resolved by the ingest hook from the install the trail belongs to,
    // never sent by the daemon: an install that could attribute its own
    // entries could attribute them to somebody else. Not marked `required`
    // for the same reason Redemption.organization is not: required-field
    // validation runs before `before_validate`, so a field the client is
    // meant not to send cannot also be one the client must send. The binding
    // is `required = true`, so the hook always runs and always fills it.
    operator:      -> Operator
    install:       -> AgentInstall required

    // Chain position as the agent recorded it. Unique per tenant, so a
    // replayed entry collides instead of duplicating.
    chain_seq:     integer(min: 0) required indexed @exportable
    entry_hash:    text(max: 128) required unique indexed @exportable
    prev_hash:     text(max: 128) required @exportable

    // The sealed acton-ai AuditEntry, verbatim: exactly the JSONL object the
    // daemon wrote. The plane can re-run chain verification over this column
    // and reproduce `head_hash`; that is the auditor's proof. Every columnar
    // field below is a projection of it and may be re-derived; this may not.
    entry:         json required

    occurred_at:   datetime required indexed @format("relative") @exportable
    recorded_at:   datetime @default("now") @exportable

    // `turn` is one attempted model turn, sealed whether or not it called a
    // tool. Without it the export answers "what did this install run" and
    // never "what did this install ask", so a session that produced code and
    // called nothing left no row at all. A refused turn is a `turn` row too:
    // an install that lost its seat and was turned away fifty times is a
    // finding, and silence is not one.
    kind:          enum("session_start", "session_end", "turn", "tool_call", "approval", "escalation", "policy_load")
                   required
                   @enum_colors(
                       session_start: "blue",
                       session_end: "gray",
                       turn: "purple",
                       tool_call: "neutral",
                       approval: "teal",
                       escalation: "amber",
                       policy_load: "violet"
                   )
                   @list(column)
                   @exportable

    // Empty on a `turn` row: a turn is not a tool call and naming one here
    // would put it in the same bucket as the calls it made.
    tool_name:     text(max: 128) indexed @exportable
    // Canonicalized argv as the policy gate saw it, not the raw shell string.
    command:       text(max: 2048) @exportable

    // On a `tool_call` row this is the approval gate's verdict. On a `turn`
    // row it is admission's: a turn that ran was let through
    // (`auto_approved`) and a turn that did not was refused (`forbidden`).
    // Admission is a gate in exactly the sense approval is, so a turn fills
    // the same column rather than needing one of its own — and `justification`
    // carries the rendered reason a refusal came with.
    decision:      enum("auto_approved", "approved", "denied", "forbidden", "timed_out")
                   required
                   @enum_colors(
                       auto_approved: "green",
                       approved: "teal",
                       denied: "red",
                       forbidden: "red",
                       timed_out: "amber"
                   )
                   @list(column)
                   @exportable

    // Which gate produced the verdict, and the identity behind it when a human
    // was in the loop. Admission is never a person — nobody is prompted to let
    // a turn start — so a refused turn reads `policy` and an admitted one
    // reads `default`.
    decider:       enum("policy", "callback", "operator", "default")
                   required
                   @exportable
    decided_by:    text(max: 320) @exportable
    justification: text(max: 1024) @exportable

    // Absent on a refused `tool_call` and on a refused `turn` alike: neither
    // ran, and recording `error` for a refusal would file it beside a failure.
    outcome:       enum("success", "error", "aborted")
                   @enum_colors(success: "green", error: "red", aborted: "gray")
                   @exportable

    // False on every `turn` row. The daemon writes it explicitly rather than
    // inheriting this default, because a turn confines nothing.
    sandboxed:     boolean default(true) @exportable
    // Milliseconds, lifted from the entry's `duration_ms`. An integer rather
    // than a `duration` because the hook proto generator cannot carry a
    // duration, and a hooked schema must be expressible on the wire.
    elapsed_ms:    integer(min: 0) @exportable

    // The rule that fired, when one did.
    command_rule:  -> CommandRule
    tool_rule:     -> ToolRule

    // Free-form payload. Deliberately not @exportable: a bulk file is the
    // wrong place for whatever a tool happened to attach.
    detail:        json

    // What a `turn` row adds, and only a `turn` row fills.
    //
    // Metadata, deliberately and permanently. Byte counts make user activity
    // and response length auditable — which is the shape a compliance regime
    // actually asks for — without copying a prompt or an answer into a trail
    // that leaves the workstation and lands in a SIEM. There is no column here
    // for prompt text, and adding one would be a decision about retention
    // rather than about auditing.
    //
    // Appended after `detail` rather than filed beside the columns they read
    // with, because the hook proto numbers its fields in declaration order: a
    // field inserted in the middle renumbers every field after it, and a
    // renumbered tag is a wire break for any plane still holding the old
    // descriptor.
    provider:       text(max: 64) @exportable
    model:          text(max: 128) indexed @exportable
    prompt_bytes:   integer(min: 0) @exportable
    // Also filled on a `tool_call` row, from the entry's serialized result.
    response_bytes: integer(min: 0) @exportable
    input_tokens:   integer(min: 0) @exportable
    output_tokens:  integer(min: 0) @exportable
}

// Per-trail chain state as the plane verified it, maintained by the audit
// service as entries arrive. One chain per trail, not per session. The
// operator token cannot touch this row: the install reports its own view on
// AuditTrail, and the two disagreeing is the finding.
//
// Verification is a background job, not a read-path cost: `head_hash` and
// `head_seq` say where the chain is, `verified_through` says how far it has
// been re-walked, and `integrity` says what the last walk found.
@version(1)
@tenant(parent: "Organization")
@display("trail_id")
@access(
    read:   ["team_lead", "auditor", "security_officer", "org_admin", "audit_service"],
    write:  ["audit_service"],
    delete: ["org_admin"]
)
@export(formats: [csv, ndjson], bundle_files: false, max_rows: 100000)
schema AuditChain {
    trail_id:         text(max: 64) required unique indexed @exportable @list(primary)
    trail:            -> AuditTrail required
    organization:     -> Organization required
    install:          -> AgentInstall required

    // The sealing format of the entries on this chain. "acton-ai/1" is the
    // only value for 1.0; it is here so a future format is a new value rather
    // than a silent reinterpretation of old rows. Defaulted rather than bare
    // required so a row the hook creates never fails on a field it did not
    // think to send.
    format:           text(max: 32) default("acton-ai/1") @exportable

    head_hash:        text(max: 128) required @exportable
    head_seq:         integer(min: 0) default(0) @exportable
    verified_through: integer(min: 0) default(0) @exportable

    integrity:        enum("unverified", "intact", "gap", "broken")
                      default("unverified")
                      // Binds the value for the @require on `finding`; see below.
                      @default("'unverified'")
                      @enum_colors(unverified: "gray", intact: "green", gap: "amber", broken: "red")
                      @list(column)
                      @exportable

    // Set when integrity leaves 'intact'; a broken chain that says nothing is
    // worse than no chain at all.
    finding:          text(max: 1024)
                      @default("''")
                      @require(
                          "integrity == 'unverified' || integrity == 'intact' || size(finding) > 0",
                          "a gap or a broken chain must record what was found"
                      )
                      @exportable

    first_seen_at:    datetime @default("now") @exportable
    last_entry_at:    datetime @exportable
    last_verified_at: datetime @exportable
}
