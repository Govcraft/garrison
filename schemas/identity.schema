// Garrison control plane — who may run the agent, and under what entitlement.
//
// Operator is the human developer as the control plane knows them: an Entra ID
// principal, not a console login. SchemaForge's system `User` schema remains
// the login store for this administrative console; an Operator is the subject
// a running garrison-agent acts *for*, and the identity every audit entry and
// every seat charge resolves back to.
//
// `directory_service` is the reconciler that projects the organization's
// Entra ID group onto these rows. It owns `upn`, `display_name`, `email`, and
// `status` from the directory's point of view: a rename patches the row in
// place, a disabled account suspends it, a removed member offboards it. The
// join key is `entra_object_id`; a hand-typed operator without one is linked
// exactly once by case-insensitive UPN match, and after that the UPN is never
// used as a join again.

@version(1)
@tenant(parent: "Organization")
@display("upn")
@access(
    read:   ["operator", "team_lead", "auditor", "security_officer", "org_admin", "enrollment_service", "directory_service"],
    write:  ["org_admin", "directory_service"],
    delete: ["org_admin"]
)
schema Operator {
    // userPrincipalName from Entra ID. The natural key an agent presents.
    upn:             text(max: 320) required unique indexed
    display_name:    text(max: 255) required @list(column)
    email:           text(max: 320) indexed

    // Entra ID objectId (GUID). Stable across UPN changes, so this is what
    // long-lived records should join on.
    entra_object_id: text(max: 64) unique indexed

    // When the directory last confirmed this row. Per-row proof that the
    // reconciler saw this person, distinct from the organization-wide stamp.
    directory_synced_at: datetime @format("relative")

    organization:    -> Organization required
    team:            -> Team

    status:          enum("invited", "active", "suspended", "offboarded")
                     default("invited")
                     @enum_colors(
                         invited: "blue",
                         active: "green",
                         suspended: "amber",
                         offboarded: "gray"
                     )
                     @list(column)

    onboarded_at:    datetime
    last_seen_at:    datetime
    created_at:      datetime @default("now")

    installs:        -> AgentInstall[]
    sessions:        -> AgentSession[]
}

// The entitlement. A seat is what makes an enrolled install allowed to prompt
// a model: no active seat, no turns. Revocation is the offboarding lever, and
// it is deliberately expensive to do silently — a revoked seat must say why.
//
// The directory reconciler may write here, and the `@field_access` fences
// bound what that means: it can move `status` to revoked and record when and
// why, and nothing else. Who a seat belongs to, what tier it is, and when it
// expires stay with org_admin. The sync can only take a seat away.
@version(1)
@tenant(parent: "Organization")
@access(
    read:   ["operator", "team_lead", "auditor", "security_officer", "org_admin"],
    write:  ["org_admin", "directory_service"],
    delete: ["org_admin"]
)
schema Seat {
    operator:          -> Operator required @field_access(write: ["org_admin"])
    organization:      -> Organization required @field_access(write: ["org_admin"])

    tier:              enum("standard", "elevated") default("standard") @field_access(write: ["org_admin"])

    status:            enum("assigned", "active", "revoked", "expired")
                       default("assigned")
                       // The @default annotation is what binds this value for the
                       // @require below: a literal default() alone is applied after
                       // the rule phases, so the predicate would hit an unbound
                       // reference and fail the write with a 500.
                       @default("'assigned'")
                       @enum_colors(
                           assigned: "blue",
                           active: "green",
                           revoked: "red",
                           expired: "gray"
                       )
                       @list(column)

    assigned_at:       datetime @default("now")
    activated_at:      datetime @field_access(write: ["org_admin"])
    expires_at:        datetime @field_access(write: ["org_admin"])
    revoked_at:        datetime

    revocation_reason: text(max: 512)
                       @default("''")
                       @require(
                           "status != 'revoked' || size(revocation_reason) > 0",
                           "revoking a seat requires a recorded reason"
                       )
}
